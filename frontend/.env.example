# Copia este archivo como .env.local (no se sube a GitHub).

# URL del backend FastAPI. Local con docker-compose: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Llave de Gemini para el asistente. OJO: vite.config.ts la incrusta en el
# JavaScript del navegador, así que cualquiera que abra la página publicada
# puede leerla. No publiques el frontend con esta llave hasta mover el
# asistente al backend.
GEMINI_API_KEY=
